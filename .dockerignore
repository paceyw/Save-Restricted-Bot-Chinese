# Secrets — never bake into the image
.env
.env.*
!.env.example

# Telegram session files (contain auth credentials)
*.session
*.session-journal
*.session-shm
*.session-wal

# VCS / tooling
.git
.gitignore
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.pyc

# Runtime data and local artifacts
runtime/
logs/
downloads/
tmp/
*.log
*.mp4
*.mp3
*.mkv
*.jpg
*.jpeg
*.png
*.webp
*.temp
*.part*

# Tests are not needed at runtime
tests/
