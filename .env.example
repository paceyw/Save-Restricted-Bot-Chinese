# Copy to .env and replace every __REQUIRED_*__ value before starting the bot.
# Never commit .env, session strings, cookies, or runtime data.

# Telegram credentials (required)
API_ID=__REQUIRED_API_ID__
API_HASH=__REQUIRED_API_HASH__
BOT_TOKEN=__REQUIRED_BOT_TOKEN__
OWNER_ID=__REQUIRED_OWNER_ID__
LOG_GROUP=__REQUIRED_LOG_GROUP_ID__
FORCE_SUB=__REQUIRED_FORCE_SUB_CHAT_ID__

# MongoDB credentials and internal URI (generated locally for this deployment)
MONGO_ROOT_USERNAME=__GENERATE_MONGO_ROOT_USERNAME__
MONGO_ROOT_PASSWORD=__GENERATE_MONGO_ROOT_PASSWORD__
MONGO_APP_USERNAME=__GENERATE_MONGO_APP_USERNAME__
MONGO_APP_PASSWORD=__GENERATE_MONGO_APP_PASSWORD__
MONGO_DB=mongodb://__MONGO_APP_USERNAME__:__MONGO_APP_PASSWORD__@mongo:27017/telegram_downloader?authSource=admin
DB_NAME=telegram_downloader

# Session encryption (generate fresh random values; do not use upstream defaults)
MASTER_KEY=__GENERATE_RANDOM_32_BYTE_HEX__
IV_KEY=__GENERATE_RANDOM_16_BYTE_HEX__

# Optional project settings
STRING=
FREEMIUM_LIMIT=0
PREMIUM_LIMIT=500
# Rate control (anti-flood) — seconds between requests
# BATCH_INTERVAL 是批量/计数任务的自适应间隔上限；BATCH_MIN_INTERVAL 是下限（起始值）。
# 无 FloodWait 时间隔从下限起步，触发 FloodWait 后按 3 倍退避（封顶上限）再逐步回落。
# 恢复旧版固定 10s 行为：BATCH_MIN_INTERVAL=10
BATCH_MIN_INTERVAL=2
BATCH_INTERVAL=10
MERGE_INTERVAL=5
CHANNEL_INTERVAL=5
UPLOAD_INTERVAL=2
# 进度消息编辑节流（秒），≥该间隔才编辑一次，100% 必发
PROGRESS_MIN_INTERVAL=3
MAX_FLOOD_RETRIES=3
# missav 下载（issue #13）：镜像域名逗号分隔，留空用内置列表；分段下载并发数
MISSAV_MIRRORS=
MISSAV_SEGMENT_CONCURRENCY=8
MISSAV_MAX_JOBS=2
# getav 下载（与 missav 同一 HLS 管线）：镜像域名逗号分隔，留空用 getav.net；
# 分段并发与任务上限复用 MISSAV_SEGMENT_CONCURRENCY / MISSAV_MAX_JOBS
GETAV_MIRRORS=
# 字幕烧录转码预算：同一时刻最多几个烧录任务（libx264 重编码峰值 ~0.5GB）；
# 编码线程数 0=自动(2..8)；单次烧录超时秒数（超时回退无字幕封装）
BURN_CONCURRENCY=1
FFMPEG_BURN_THREADS=0
BURN_TIMEOUT_S=10800
# 任务准入磁盘水位（GB）：运行卷剩余空间低于该值时拒绝新任务（已运行任务不受影响）
DISK_FREE_MIN_GB=10
INSTA_COOKIES=
JOIN_LINK=https://t.me/team_spy_pro
ADMIN_CONTACT=
# 付费提示文案（/start /pay /plan /myplan 非会员分支统一展示）；不填则使用 config.py 默认值
PAY_NOTICE=
PLAN_D_S=1
PLAN_D_DU=1
PLAN_D_U=days
PLAN_D_L=Daily
PLAN_W_S=3
PLAN_W_DU=1
PLAN_W_U=weeks
PLAN_W_L=Weekly
PLAN_M_S=5
PLAN_M_DU=1
PLAN_M_U=month
PLAN_M_L=Monthly

# Runtime identity for the non-root bot process
BOT_UID=1000
BOT_GID=1000
